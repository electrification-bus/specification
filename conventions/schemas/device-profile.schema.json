{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ebus.energy/schemas/device-profile.json",
  "title": "eBus device-profile property composition",
  "description": "Machine-readable device profile for one energy.ebus.device.* model. It composes capability catalogs, records per-device conformance, defines device-specific properties, and (for a device-defining inline capability) defines that capability inline. Generated from the data-model Markdown and verified against it; see conventions/property-json.md. This schema constrains STRUCTURE only. The semantic invariants (a referenced property exists in its catalog with matching datatype and unit, monotonic conformance, every type registered) are enforced by tools/check-property-catalogs.py, not here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "device", "version", "device_types"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "property-schema-v1" },
    "kind": { "const": "device-profile" },
    "device": { "type": "string", "pattern": "^energy\\.ebus\\.device\\.[a-z0-9-]+$" },
    "version": { "type": "string" },
    "status": { "type": "string" },
    "date": { "type": "string" },
    "device_types": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^energy\\.ebus\\.device\\.[a-z0-9-]+$" },
      "additionalProperties": { "$ref": "#/$defs/deviceTypeEntry" }
    }
  },
  "$defs": {
    "req": { "enum": ["MUST", "SHOULD", "MAY"] },
    "datatype": {
      "enum": ["integer", "float", "boolean", "string", "enum", "color", "datetime", "duration", "json"]
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "datatype"],
      "properties": {
        "name": { "type": "string" },
        "datatype": { "$ref": "#/$defs/datatype" },
        "unit": { "type": "string" },
        "format": { "type": "string" },
        "settable": { "type": "boolean" },
        "req": { "$ref": "#/$defs/req" }
      }
    },
    "propertyPattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datatype", "expand"],
      "properties": {
        "name": { "type": "string" },
        "datatype": { "$ref": "#/$defs/datatype" },
        "unit": { "type": "string" },
        "format": { "type": "string" },
        "settable": { "type": "boolean" },
        "req": { "$ref": "#/$defs/req" },
        "expand": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    },
    "capabilityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog"],
      "properties": {
        "catalog": { "type": "string", "pattern": "^energy\\.ebus\\.capability\\.[a-z0-9-]+$" },
        "catalog_version": { "type": "string" },
        "req": { "$ref": "#/$defs/req" },
        "reference_direction": { "type": "string" },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "req": { "$ref": "#/$defs/req" } }
          }
        }
      }
    },
    "deviceTypeEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": { "enum": ["parent", "child"] },
        "capabilities": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/capabilityRef" }
        },
        "added_properties": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/property" }
          }
        },
        "defines_capability": { "$ref": "#/$defs/definesCapability" }
      }
    },
    "definesCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "properties"],
      "properties": {
        "capability": { "type": "string", "pattern": "^energy\\.ebus\\.capability\\.[a-z0-9-]+$" },
        "req_default": { "$ref": "#/$defs/req" },
        "reference_direction_default": { "type": "string" },
        "properties": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/property" }
        },
        "property_patterns": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/propertyPattern" }
        }
      }
    }
  }
}
