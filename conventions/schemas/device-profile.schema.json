{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ebus.energy/schemas/device-profile.json",
  "title": "eBus device-profile property composition",
  "description": "Machine-readable device profile for one energy.ebus.device.* model. `device_types` records which device type in the model publishes which capability, at what capability-level conformance. `capabilities` carries, once per capability node, the model's property-level detail: catalog-property Req overrides, device-specific added properties, and (for a device-defining inline capability) the inline definition. Generated from the data-model Markdown and verified against it; see conventions/property-json.md. This schema constrains STRUCTURE only. The semantic invariants (a referenced property exists in its catalog with matching datatype/unit, monotonic conformance, every type registered) are enforced by tools/check-property-catalogs.py, not here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "device", "version", "device_types", "capabilities"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "property-schema-v1" },
    "kind": { "const": "device-profile" },
    "device": { "type": "string", "pattern": "^energy\\.ebus\\.device\\.[a-z0-9-]+$" },
    "version": { "type": "string" },
    "status": { "type": "string" },
    "date": { "type": "string" },
    "device_types": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^energy\\.ebus\\.device\\.[a-z0-9-]+$" },
      "additionalProperties": { "$ref": "#/$defs/deviceType" }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/capabilityProfile" }
    }
  },
  "$defs": {
    "req": { "enum": ["MUST", "SHOULD", "MAY"] },
    "datatype": {
      "enum": ["integer", "float", "boolean", "string", "enum", "color", "datetime", "duration", "json"]
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datatype"],
      "properties": {
        "name": { "type": "string" },
        "datatype": { "$ref": "#/$defs/datatype" },
        "unit": { "type": "string" },
        "format": { "type": "string" },
        "settable": { "type": "boolean" },
        "req": { "$ref": "#/$defs/req" },
        "description": { "type": "string" }
      }
    },
    "propertyPattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datatype", "expand"],
      "properties": {
        "name": { "type": "string" },
        "datatype": { "$ref": "#/$defs/datatype" },
        "unit": { "type": "string" },
        "format": { "type": "string" },
        "settable": { "type": "boolean" },
        "req": { "$ref": "#/$defs/req" },
        "description": { "type": "string" },
        "expand": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "deviceType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publishes"],
      "properties": {
        "role": { "enum": ["parent", "child"] },
        "publishes": {
          "type": "object",
          "description": "capability node id -> the device-level conformance for that capability on this device type",
          "additionalProperties": { "$ref": "#/$defs/req" }
        }
      }
    },
    "capabilityProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog"],
      "properties": {
        "catalog": { "type": "string", "pattern": "^energy\\.ebus\\.capability\\.[a-z0-9-]+$" },
        "catalog_version": { "type": "string" },
        "reference_direction": { "type": "string" },
        "properties": {
          "type": "object",
          "description": "overrides of catalog properties this model tightens or selects, by property id",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "req": { "$ref": "#/$defs/req" } }
          }
        },
        "added": {
          "type": "object",
          "description": "device-model-specific properties not present in the catalog, by property id",
          "additionalProperties": { "$ref": "#/$defs/property" }
        },
        "added_patterns": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/propertyPattern" }
        },
        "defines_capability": {
          "type": "boolean",
          "description": "true when this is a device-defining capability defined inline in the model (allowlisted, e.g. water-heater) rather than referencing a standalone catalog"
        }
      }
    }
  }
}
